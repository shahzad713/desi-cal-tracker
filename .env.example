# Copy to .env and fill in:
#   cp .env.example .env

# Database — local dev uses SQLite; Day 14 switches to Neon Postgres.
DATABASE_URL="file:./dev.db"

# Demo mode: "true" (default) = rotating sample analyses, no API key needed.
# For REAL AI (Day 3+): set to "false" AND provide GEMINI_API_KEY below.
# With no key configured, the app gracefully falls back to demo samples.
NEXT_PUBLIC_DEMO_MODE=true

# Auth.js — REQUIRED. Generate a fresh one per environment:
#   openssl rand -base64 32
# (Vercel: set in the dashboard on Day 14, never in the repo.)
AUTH_SECRET=your-32-byte-secret-here

# Google OAuth (optional — email/password login works without it)
# https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Day 3 — Gemini vision API key (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=

# Day 10 — Stripe billing, TEST MODE keys only until launch
# (dashboard → Developers → API keys; use the "test mode" keys)
# STRIPE_SECRET_KEY=
# Price id for the Pro subscription (Products → create "Pro", monthly, test mode)
# STRIPE_PRICE_ID=price_...
# Signing secret for the /api/stripe/webhook endpoint (Developers → Webhooks)
# STRIPE_WEBHOOK_SECRET=
# Public base URL used for checkout success/cancel redirects (no trailing slash)
# NEXT_PUBLIC_APP_URL=https://desi-cal-ai.example.com

# Day 12 — Admin panel bootstrap. Comma-separated list of emails that are
# treated as admins (server-side only, never exposed to clients). This is how
# the FIRST admin exists before any admin can grant the role in /admin.
# Afterwards, admins grant/revoke the persisted isAdmin flag in the panel.
# ADMIN_EMAILS=you@example.com
