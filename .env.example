# Copy to .env and fill in:
#   cp .env.example .env

# Database — local dev uses SQLite; Day 14 switches to Neon Postgres.
DATABASE_URL="file:./dev.db"

# Demo mode: "true" = rotating sample analyses, no API key needed.
# Day 3: set to "false" and provide GEMINI_API_KEY below.
NEXT_PUBLIC_DEMO_MODE=true

# Day 3 — Gemini vision API key (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=
