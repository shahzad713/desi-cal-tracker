# Copy to .env and fill in:
#   cp .env.example .env

# Database — Neon Postgres (Day 14+). Local dev and production both point at
# Neon now; no local Postgres needed.
# Pooled connection string (what the app uses at runtime) — Neon dashboard →
# your project → Connection Details → check "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/desi-cal-ai?sslmode=require"
# Direct (non-pooled) connection — used ONLY by `prisma db push` (schema sync).
# Never needed by the running app; required in .env for prisma CLI commands.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/desi-cal-ai?sslmode=require"

# Demo mode: "true" (default) = rotating sample analyses, no API key needed.
# For REAL AI (Day 3+): set to "false" AND provide GEMINI_API_KEY below.
# With no key configured, the app gracefully falls back to demo samples.
NEXT_PUBLIC_DEMO_MODE=true

# Auth.js — REQUIRED. Generate a fresh one per environment:
#   openssl rand -base64 32
# (Vercel: set in the dashboard on Day 14, never in the repo.)
AUTH_SECRET=your-32-byte-secret-here

# Production canonical URL — REQUIRED on Vercel so Auth.js builds correct
# callback URLs (or set AUTH_TRUST_HOST=true instead). No trailing slash.
# AUTH_URL=https://desi-cal-ai.vercel.app

# Google OAuth (optional — email/password login works without it)
# https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Day 3 — Gemini vision API key (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=

# Day 10 — Stripe billing, TEST MODE keys only until launch
# (dashboard → Developers → API keys; use the "test mode" keys)
# OPTIONAL: leave all three unset and the app deploys fine — /billing shows
# "payments not configured", checkout/portal return a clean error, and the
# webhook route rejects with 503. Wire real keys when ready; nothing breaks.
# STRIPE_SECRET_KEY=
# Price id for the Pro subscription (Products → create "Pro", monthly, test mode)
# STRIPE_PRICE_ID=price_...
# Signing secret for the /api/stripe/webhook endpoint (Developers → Webhooks)
# STRIPE_WEBHOOK_SECRET=
# Public base URL used for checkout success/cancel redirects (no trailing slash)
# NEXT_PUBLIC_APP_URL=https://desi-cal-ai.example.com

# Day 12 — Admin panel bootstrap. Comma-separated list of emails that are
# treated as admins (server-side only, never exposed to clients). This is how
# the FIRST admin exists before any admin can grant the role in /admin.
# Afterwards, admins grant/revoke the persisted isAdmin flag in the panel.
# ADMIN_EMAILS=you@example.com

# Day 13 — Sentry error tracking (optional until launch; the SDK is dormant
# without these). Get the DSN from the Sentry dashboard → project settings.
# The public DSN is write-only by design; the server DSN stays secret.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
