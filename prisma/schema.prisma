// Desi Cal AI — Prisma schema (Day 4)
// Dev database: SQLite (DATABASE_URL="file:./dev.db").
// DAY 14: switch `provider` to "postgresql" and point DATABASE_URL at Neon.
// The schema deliberately uses only cross-compatible features (cuid(), Float,
// DateTime, no SQLite-only tricks) so the Day-14 migration is a one-line change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  emailVerified DateTime?
  image         String?
  passwordHash  String? // bcrypt hash; NULL for OAuth-only accounts
  createdAt     DateTime    @default(now())
  entries       FoodEntry[]
  accounts      Account[]
  sessions      Session[]
}

// --- Auth.js (NextAuth v5) models — required by @auth/prisma-adapter ---
// Day 14: these stay identical on Postgres (all cross-compatible types).

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FoodEntry {
  id           String   @id @default(cuid())
  userId       String? // NULL until Auth.js lands on Day 2
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dishName     String
  dishNameUrdu String?
  calories     Int
  protein      Float // grams
  carbs        Float // grams
  fat          Float // grams
  portion      String
  imagePath    String? // e.g. /uploads/<uuid>.jpg (public/uploads is gitignored)
  createdAt    DateTime @default(now())
  // Day 4: portion tracking. The current values are always
  // round(baseX * portionScale) — scaling from the base never drifts,
  // no matter how many times the portion is adjusted.
  portionScale Float @default(1)
  baseCalories Int   @default(0)
  baseProtein  Float @default(0)
  baseCarbs    Float @default(0)
  baseFat      Float @default(0)

  @@index([userId])
  @@index([createdAt])
}

// Reference nutrition data for common desi dishes.
// Day 1: seeded with 10 dishes. Day 7: expanded to 200+ with search + Urdu names.
model Dish {
  id          String  @id @default(cuid())
  name        String  @unique
  nameUrdu    String?
  calories    Int // per serving
  protein     Float // grams per serving
  carbs       Float // grams per serving
  fat         Float // grams per serving
  servingSize String
}
