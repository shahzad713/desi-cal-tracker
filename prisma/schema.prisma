// Desi Cal AI — Prisma schema (Day 10)
// Dev database: SQLite (DATABASE_URL="file:./dev.db").
// DAY 14: switch `provider` to "postgresql" and point DATABASE_URL at Neon.
// The schema deliberately uses only cross-compatible features (cuid(), Float,
// DateTime, no SQLite-only tricks) so the Day-14 migration is a one-line change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  emailVerified DateTime?
  image         String?
  passwordHash  String? // bcrypt hash; NULL for OAuth-only accounts
  createdAt     DateTime    @default(now())
  entries       FoodEntry[]
  accounts      Account[]
  sessions      Session[]
  // Day 6: personal goals. dailyCalorieTarget is the user's own daily budget
  // (used by the dashboard + goals page instead of the 2,000 default).
  // currentWeight/targetWeight are in kilograms; NULL until the user sets them.
  dailyCalorieTarget Int   @default(2000)
  currentWeight      Float?
  targetWeight       Float?
  // Day 10: Stripe billing (test mode). Pro = unlimited AI scans.
  // isPro is set ONLY by signature-verified Stripe webhooks (see
  // app/api/stripe/webhook/route.ts) — never by client claims.
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?
  isPro                Boolean  @default(false)
}

// --- Auth.js (NextAuth v5) models — required by @auth/prisma-adapter ---
// Day 14: these stay identical on Postgres (all cross-compatible types).

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FoodEntry {
  id           String   @id @default(cuid())
  userId       String? // NULL until Auth.js lands on Day 2
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dishName     String
  dishNameUrdu String?
  calories     Int
  protein      Float // grams
  carbs        Float // grams
  fat          Float // grams
  portion      String
  imagePath    String? // e.g. /uploads/<uuid>.jpg (public/uploads is gitignored)
  createdAt    DateTime @default(now())
  // Day 4: portion tracking. The current values are always
  // round(baseX * portionScale) — scaling from the base never drifts,
  // no matter how many times the portion is adjusted.
  portionScale Float @default(1)
  baseCalories Int   @default(0)
  baseProtein  Float @default(0)
  baseCarbs    Float @default(0)
  baseFat      Float @default(0)

  @@index([userId])
  @@index([createdAt])
}

// Day 9: marketing waitlist — launch updates + early Pro access.
// Public endpoint by design; abuse is handled with validation + rate limits
// in the server action (lib/waitlist.ts), not with auth.
model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique // lowercased + trimmed at write time
  name      String? // optional first name, plain text ≤ 60 chars
  source    String? // where they signed up, e.g. "landing-v2"
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Reference nutrition data for common desi dishes.
// Day 1: seeded with 10 dishes. Day 7: expanded to 200+ with search + Urdu
// names + categories; the /dishes page lets users browse, search and one-tap
// log any dish (manual add without a photo).
model Dish {
  id          String  @id @default(cuid())
  name        String  @unique
  nameUrdu    String?
  calories    Int // per serving
  protein     Float // grams per serving
  carbs       Float // grams per serving
  fat         Float // grams per serving
  servingSize String
  category    String  @default("Other") // one of DISH_CATEGORIES (lib/dishes.ts)

  @@index([category])
}
